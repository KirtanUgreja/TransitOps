# Frontend environment — copy to frontend/.env.local (git-ignored).
# Has a working default, so .env.local is optional for local dev.

# Base URL of the FastAPI backend the browser calls.
# NEXT_PUBLIC_ prefix = exposed to the browser (this is a public URL, not a secret).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk (admin sign-in). Get these from the Clerk dashboard → API keys.
# `clerk init` writes real values into .env.local automatically. Placeholders only here.
# The publishable key is public; the SECRET KEY must never be committed.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
