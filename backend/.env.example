# Backend environment — copy to backend/.env (git-ignored).
# Every var has a working default, so .env is optional for local dev.
# Copy this file only if you need to override something.

# Connection to Postgres. The default matches database/docker-compose.yml
# (db, user, and password are all "transitops").
DATABASE_URL=postgresql+psycopg://transitops:transitops@localhost:5432/transitops

# Secret used to sign JWTs. Fine as-is for local/demo; set a real random
# value for anything shared or deployed.
JWT_SECRET=transitops-dev-secret

# Clerk issuer — the backend verifies admin (Clerk) session tokens against this
# instance's JWKS. It's your Clerk Frontend API URL (Clerk dashboard → API keys),
# e.g. https://<your-subdomain>.clerk.accounts.dev. Only needed if you use Clerk login.
CLERK_ISSUER=https://your-subdomain.clerk.accounts.dev
